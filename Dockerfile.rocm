# JAX-on-ROCm official image (pick a pinned tag for reproducibility)
# Example tag from AMD docs: rocm7.2 + jax0.8.0 + py3.11
FROM rocm/jax:rocm7.2-jax0.8.0-py3.11

WORKDIR /app

# Helps XLA find ROCm's lld in some setups (AMD doc recommendation)
ENV LLVM_PATH=/opt/rocm/llvm

# Copy project
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

# Install repo tooling explicitly without touching the ROCm JAX stack.
RUN pip install pytest ruff

# IMPORTANT:
# Your pyproject currently depends on `jax`/`jaxlib`. This base image already has the ROCm-enabled stack.
# Install your package WITHOUT pulling deps, so you don't accidentally overwrite ROCm JAX with CPU wheels.
RUN pip install --no-deps -e .

CMD ["python", "-m", "metroflow.demo"]
